{
  "id": null,
  "uid": "mc-infrastructure",
  "title": "Infrastructure",
  "tags": ["minecraft", "infrastructure", "backup", "dyndns"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-30d", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Latest Backup",
      "description": "Timestamp of the newest backup and currently available disk space on Boxli.",
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "minecraft_backup_last_success_timestamp_seconds * 1000 and minecraft_backup_last_success_timestamp_seconds > 0",
          "instant": true,
          "range": false,
          "legendFormat": "Latest backup",
          "refId": "A"
        },
        {
          "expr": "max(node_filesystem_avail_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"})",
          "instant": true,
          "range": false,
          "legendFormat": "Free disk",
          "refId": "B"
        }
      ],
      "options": {
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": ""
        }
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "N/A",
          "color": { "mode": "fixed", "fixedColor": "green" }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Latest backup"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Free disk"
            },
            "properties": [
              {
                "id": "unit",
                "value": "decbytes"
              }
            ]
          }
        ]
      },
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Backups (Size + Timestamp)",
      "description": "All backup files currently present, with size in MB and formatted timestamp.",
      "gridPos": { "h": 16, "w": 12, "x": 12, "y": 5 },
      "targets": [
        {
          "expr": "minecraft_backup_file_size_bytes / 1024 / 1024",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "A"
        },
        {
          "expr": "minecraft_backup_file_mtime_seconds * 1000",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "B"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Timestamp",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Size (MB)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "mbytes"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Timestamp"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "file",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Value": true,
              "file 1": true,
              "__name__ 1": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "indexByName": {
              "file": 0,
              "Value #B": 1,
              "Value #A": 2
            },
            "renameByName": {
              "file": "Backup",
              "Value #A": "Size (MB)",
              "Value #B": "Timestamp"
            }
          }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "id": 3,
      "type": "table",
      "title": "Public IP",
      "description": "Current public IPv4 and IPv6 addresses.",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (entry) (label_replace(topk(1, timestamp(minecraft_dyndns_last_check_info{ipv4=~\".+\"})), \"entry\", \"$1\", \"ipv4\", \"(.*)\") or label_replace(topk(1, timestamp(minecraft_dyndns_last_check_info{ipv4=~\".+\"})), \"entry\", \"$1\", \"ipv6\", \"(.*)\"))",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "options": {
        "showHeader": false,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "cellOptions": { "type": "auto" },
            "inspect": false
          }
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "status": true,
              "timestamp": true,
              "ipv4": true,
              "ipv6": true,
              "previous_status": true
            },
            "indexByName": {
              "entry": 0
            },
            "renameByName": {
              "entry": "Value"
            }
          }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Last DynDNS Request",
      "description": "Latest request timestamp and second last request status.",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "sum by (entry) (label_replace(topk(1, timestamp(minecraft_dyndns_last_request_panel_info)), \"entry\", \"$1\", \"timestamp\", \"(.*)\") or label_replace(topk(1, timestamp(minecraft_dyndns_last_request_panel_info)), \"entry\", \"$1\", \"previous_status\", \"(.*)\"))",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "options": {
        "showHeader": false,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "cellOptions": { "type": "auto" },
            "inspect": false
          }
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "status": true,
              "timestamp": true,
              "ipv4": true,
              "ipv6": true,
              "previous_status": true
            },
            "indexByName": {
              "entry": 0
            },
            "renameByName": {
              "entry": "Value"
            }
          }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "id": 4,
      "type": "logs",
      "title": "DynDNS Logs",
      "description": "All log entries from the dyndns container.",
      "gridPos": { "h": 16, "w": 12, "x": 0, "y": 5 },
      "targets": [
        {
          "expr": "{service=\"dyndns\"}",
          "refId": "A"
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": false,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "datasource": { "type": "loki", "uid": "loki" }
    },
    {
      "id": 6,
      "type": "logs",
      "title": "Backup Logs",
      "description": "All log entries from the minecraft-backup container.",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 21 },
      "targets": [
        {
          "expr": "{service=\"backup\"}",
          "refId": "A"
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": false,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "datasource": { "type": "loki", "uid": "loki" }
    }
  ]
}
