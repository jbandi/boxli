{
  "id": null,
  "uid": "mc-containers",
  "title": "Containers Overview",
  "tags": ["minecraft", "containers"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 4,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "type": "timeseries",
      "title": "Container CPU %",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by(id) (rate(container_cpu_usage_seconds_total{job=\"cadvisor\",id!=\"/\"}[5m])) * 100",
          "legendFormat": "{{id}}"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "type": "timeseries",
      "title": "Container Memory (MiB)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum by(id) (container_memory_usage_bytes{job=\"cadvisor\",id!=\"/\"}) / 1024 / 1024",
          "legendFormat": "{{id}}"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "type": "timeseries",
      "title": "Recent Restarts (15m)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum by(id) (changes(container_start_time_seconds{job=\"cadvisor\",id!=\"/\"}[15m]))",
          "legendFormat": "{{id}}"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    }
  ]
}
