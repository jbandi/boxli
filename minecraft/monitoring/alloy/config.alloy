// Discover all running Docker containers
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

// Extract useful labels from Docker metadata
discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  // Keep container name as a label
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container_name"
  }

  // Extract compose service name
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  // Extract compose project name
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "project"
  }

  // Only keep mc, backup, and dyndns services
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "(mc|backup|dyndns)"
    action        = "keep"
  }
}

// Load player activity filter fragments from external JSON so the deny-list
// can be extended without editing the Alloy pipeline logic.
local.file "player_activity_filters" {
  filename = "/etc/alloy/player-activity-filters.json"
}

// Collect logs from discovered containers
loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  forward_to = [loki.process.filter_noise.receiver]

  relabel_rules = discovery.relabel.containers.rules
}

// Drop known noisy plugin lines from Minecraft logs before ingestion.
loki.process "filter_noise" {
  forward_to = [loki.write.default.receiver]

  stage.match {
    selector = "{service=\"mc\"}"

    stage.drop {
      expression = "Found [0-9]+ matching item\\(s\\) on player"
    }

    stage.drop {
      expression = "Thread RCON Client /.* (started|shutting down)"
    }
  }

  // Tag gameplay-focused lines for the Player Activity panel.
  // This preserves raw logs while moving heavy filtering to ingest time.
  stage.match {
    selector = "{service=\"mc\"} !~ " +
      string.format(
        "%q",
        "(?i)(" + string.join(encoding.from_json(local.file.player_activity_filters.content)["technical_noise"], "|") + ")",
      ) +
      " !~ " +
      string.format(
        "%q",
        "(?i)(" + string.join(encoding.from_json(local.file.player_activity_filters.content)["stacktrace_noise"], "|") + ")",
      ) +
      " !~ " +
      string.format(
        "%q",
        "(?i)(" + string.join(encoding.from_json(local.file.player_activity_filters.content)["session_churn_noise"], "|") + ")",
      )

    stage.static_labels {
      values = {
        activity = "player",
      }
    }
  }
}

// Push logs to Loki
loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
