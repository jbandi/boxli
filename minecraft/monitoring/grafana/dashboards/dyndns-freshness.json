{
  "id": null,
  "uid": "mc-dyndns-freshness",
  "title": "DynDNS Freshness",
  "tags": ["minecraft", "dyndns"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "30s",
  "time": { "from": "now-7d", "to": "now" },
  "panels": [
    {
      "type": "timeseries",
      "title": "DynDNS last_ip Age (hours)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "(time() - minecraft_dyndns_last_ip_mtime_seconds) / 3600",
          "legendFormat": "dyndns age"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "type": "stat",
      "title": "DynDNS Freshness Status",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "(time() - minecraft_dyndns_last_ip_mtime_seconds) <= bool 86400",
          "legendFormat": "status"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "STALE", "color": "red" }, "1": { "text": "OK", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": 0 }, { "color": "green", "value": 1 } ] }
        },
        "overrides": []
      },
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "type": "timeseries",
      "title": "DynDNS CPU %",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{container_label_com_docker_compose_project=\"minecraft\",container_label_com_docker_compose_service=\"dyndns\",image!=\"\"}[5m])) * 100",
          "legendFormat": "minecraft-dyndns"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "type": "timeseries",
      "title": "DynDNS Memory (MiB)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum(container_memory_usage_bytes{container_label_com_docker_compose_project=\"minecraft\",container_label_com_docker_compose_service=\"dyndns\",image!=\"\"}) / 1024 / 1024",
          "legendFormat": "minecraft-dyndns"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "type": "timeseries",
      "title": "DynDNS Restarts (15m)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "sum(changes(container_start_time_seconds{container_label_com_docker_compose_project=\"minecraft\",container_label_com_docker_compose_service=\"dyndns\",image!=\"\"}[15m]))",
          "legendFormat": "minecraft-dyndns"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    }
  ]
}
